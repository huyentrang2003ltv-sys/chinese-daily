# Server
PORT=3005
HOST=0.0.0.0
NODE_ENV=production
# Requests per minute per IP for uncached TTS synthesis
TTS_RATE_LIMIT=120
# Set to 1 when running behind a reverse proxy (nginx, Cloudflare) so X-Forwarded-For is trusted
TRUST_PROXY=

# Data & sessions
# Where accounts, visitor counters and the session key are stored (default: ./storage). Never served over HTTP.
STORAGE_DIR=
# Secret used to sign login cookies. Leave empty to auto-generate storage/session.key.
SESSION_SECRET=
# Admin rights are never granted through the web. On the server run:
#   npm run admin -- grant <email>     (also: revoke, list, password)
# Stop the web server first, or restart it afterwards: it keeps accounts in memory.

# Telegram notifications: VIP upgrade requests and user feedback (also used by `npm run tunnel`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VIP payment (VietQR)
# Bank BIN (e.g. 970422 = MB Bank), display name, account number and holder name
PAYMENT_BANK_BIN=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=

# Tunnel manager (optional, only used by `npm run tunnel`)
LAN_URL=
