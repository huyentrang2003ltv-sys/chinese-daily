# Server
PORT=3005
HOST=0.0.0.0
NODE_ENV=production
# Requests per minute per IP for uncached TTS synthesis
TTS_RATE_LIMIT=120
# Set to 1 when running behind exactly one reverse proxy (e.g. nginx) that sets X-Forwarded-For / X-Forwarded-Proto.
# Without it every visitor looks like 127.0.0.1 and rate limits are shared by the whole site.
TRUST_PROXY=

# Data & sessions
# Where accounts, visitor counters and the session key are stored (default: ./storage). Never served over HTTP.
STORAGE_DIR=
# Secret used to sign login cookies. Leave empty to auto-generate storage/session.key.
SESSION_SECRET=
# Admin rights: on the server run `npm run admin -- grant <email>` (also: revoke, list, password).
# Stop the web server first, or restart it afterwards: it keeps accounts in memory.
# Addresses listed here become admin automatically, but only after their owner signs in
# with Google (which proves the address); a password sign-up with them stays a student.
ADMIN_EMAILS=

# Sign in with Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
# Authorized redirect URI must be exactly GOOGLE_CALLBACK_URL. Needs HTTPS and a fixed domain in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example/api/auth/google/callback

# Telegram notifications: VIP upgrade requests and user feedback (also used by `npm run tunnel`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VIP payment (VietQR)
# Bank BIN (e.g. 970422 = MB Bank), display name, account number and holder name
PAYMENT_BANK_BIN=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=

# Tunnel manager (optional, only used by `npm run tunnel`)
LAN_URL=
